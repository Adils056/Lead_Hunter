APP_NAME="LeadPilot AI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=leadpilot_ai
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# LeadPilot AI Configuration
AI_DEFAULT_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=1500
OPENAI_TIMEOUT=30

HUNTER_API_KEY=
APOLLO_API_KEY=

LEADPILOT_DAILY_SEND_LIMIT=100
LEADPILOT_REQUIRE_APPROVAL=true
LEADPILOT_DEFAULT_CURRENCY=USD

# ---- Lead Hunting Engine v3 ----
LEADPILOT_AGENCY_NAME="Eziline Software House"
LEADPILOT_SENDER_NAME="Ismail"
LEADPILOT_AGENCY_WEBSITE=https://eziline.com
LEADPILOT_BOOKING_URL=
# Overture Maps Places (free, no key). Reads the public GeoParquet release with the bundled DuckDB CLI (tools/duckdb/duckdb.exe).
# OVERTURE_DUCKDB_BIN=C:/path/to/duckdb.exe      # only if the binary lives elsewhere
# OVERTURE_RELEASE=2026-10-21.0                   # pin a release; default = latest from stac.overturemaps.org
# OVERTURE_MIN_CONFIDENCE=0.6                     # Overture existence score 0-1
# Google Places API (New) — OPTIONAL paid alternative. Enable "Places API (New)" in Google Cloud, restrict the key to it
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_RETENTION_DAYS=30
# Optional: Google PageSpeed Insights (real mobile performance data in audits)
PAGESPEED_ENABLED=false
PAGESPEED_API_KEY=
LEADPILOT_CRAWLER_UA="LeadPilotBot/1.0 (+business website audit)"
# Remotive terms forbid using listings to collect leads — keep false unless you have permission
LEADPILOT_REMOTIVE_ENABLED=false

# Inbound webhooks (delivery events, unsubscribes, ad-platform leads): providers must sign the raw body with HMAC-SHA256 using this
# secret (header X-Webhook-Signature). Leave empty if you use no webhooks: all webhook calls are then rejected.
LEADPILOT_WEBHOOK_SECRET=
# Demo users (password123) and demo companies are seeded only when APP_ENV=local or this is true
LEADPILOT_SEED_DEMO=false
# Self-service registration page (/register). New users get the sales role; the first user of an empty install is admin.
LEADPILOT_ALLOW_REGISTRATION=true
# LEADPILOT_REGISTRATION_ROLE=sales

# ---- v4 Autopilot ----
LEADPILOT_TIMEZONE=Asia/Karachi
# Free-first budgets in US CENTS. 0 = paid providers are never called. Example: 500 = $5/day
LEADPILOT_BUDGET_DAILY_CENTS=0
LEADPILOT_BUDGET_MONTHLY_CENTS=0
LEADPILOT_MAX_FIRST_TOUCH_PER_DAY=10
# Reply sync (Gmail): enable 2-Step Verification, create an App Password, paste it here (NOT your Gmail password)
IMAP_ENABLED=false
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX
# Free local LLM (no key, nothing leaves the PC): install https://ollama.com, run `ollama pull qwen2.5:3b`. Auto-detected when running.
LEADPILOT_OLLAMA_ENABLED=true
# LEADPILOT_OLLAMA_URL=http://localhost:11434
# LEADPILOT_OLLAMA_MODEL=qwen2.5:3b
# LEADPILOT_OLLAMA_RESEARCH=false   # local model for company research too (small models invent facts; keep false under 7b)
# Free mailbox-existence check (SMTP RCPT TO on the MX; no email is sent). Needs outbound port 25; auto-detects when blocked.
LEADPILOT_SMTP_PROBE=true
# Verification waterfall: free SMTP probe first; Hunter only for MX-only/unknown results and only within budget.
LEADPILOT_HUNTER_ESCALATION=true
# Hours before an MX-only/unknown result is re-checked (proven results are cached 30 days).
LEADPILOT_EMAIL_RECHECK_HOURS=24
# Known-good MX used to tell "this domain refuses" from "this network blocks port 25" (blank = count 3 distinct domains).
LEADPILOT_SMTP_CANARY=
LEADPILOT_PORT25_BLOCK_THRESHOLD=3
# Optional free LLM for draft polishing (only public business facts are sent)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
# OpenStreetMap usage policy needs a contact address
OSM_CONTACT_EMAIL=
# Overpass mirrors, comma-separated, in order of preference. Default: overpass.private.coffee, OSM_OVERPASS_URL, overpass-api.de.
# Mirrors that time out are skipped for 20 minutes automatically; set this if one mirror is blocked on your network.
# OSM_OVERPASS_MIRRORS=https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter
# Seconds to wait for one Overpass answer (the public server often needs 30-60 s per city query)
OSM_HTTP_TIMEOUT=120
