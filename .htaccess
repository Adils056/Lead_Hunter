# LeadPilot AI — project-root .htaccess for Apache hosts where the document root is the project
# folder itself (XAMPP htdocs, cPanel/shared hosting). On a proper VPS point the vhost/nginx root at
# /public instead and this file is never read.
#
# What it does: (1) serves the app from /public without exposing it in the URL, (2) blocks direct
# access to everything that is not meant to be public (.env, storage, vendor, tests, tools, docs),
# (3) disables directory listings, (4) sends a few safe headers. Nothing here changes Laravel routing.

Options -Indexes -MultiViews
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    # No RewriteBase: paths are relative to this folder, so the same file works at the domain root
    # (leads.example.com/) and in a sub-folder (localhost/Leed_generation/).

    # --- block anything sensitive, even if a rule below is bypassed ---
    RewriteRule ^(\.env.*|\.git.*|\.htaccess|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|artisan|vite\.config\.js)$ - [F,L,NC]
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests|tools|docs|vendor|node_modules)(/|$) - [F,L,NC]

    # --- already under public/: let public/.htaccess handle it ---
    RewriteRule ^public/ - [L]

    # --- local XAMPP in a sub-folder (localhost/Leed_generation/): Laravel cannot see the sub-folder behind an
    #     internal rewrite (it would 404 every route), so redirect visibly to /public/ there. ---
    RewriteCond %{HTTP_HOST} ^(localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC]
    RewriteCond %{REQUEST_URI}::$1 ^(.*?/)(.*)::\2$
    RewriteRule ^(.*)$ %1public/%2 [R=302,L]

    # --- live host (project folder = document root): everything is served from public/ invisibly
    #     (static files directly, the rest via public/index.php) ---
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Deny by file name as a second layer (works without mod_rewrite too)
<FilesMatch "^(\.env.*|\.env\.bak.*|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|artisan|.*\.log|.*\.sql|.*\.sqlite|.*\.bak)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# PHP limits that the website audit, CSV import and Overture extract need (ignored where PHP is not an Apache module)
<IfModule mod_php.c>
    php_value upload_max_filesize 20M
    php_value post_max_size 25M
    php_value max_execution_time 300
    php_value memory_limit 512M
</IfModule>
